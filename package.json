{
  "name": "@link-loom/cloud-sdk",
  "version": "1.1.1",
  "description": "SDK for consuming Link Loom Cloud services. Service-to-service clients, React components, and app runtime contract.",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/cloud-sdk.cjs.cjs",
  "module": "dist/cloud-sdk.esm.js",
  "type": "module",
  "exports": {
    ".": {
      "require": "./dist/cloud-sdk.cjs.cjs",
      "import": "./dist/cloud-sdk.esm.js"
    },
    "./monetization": {
      "require": "./dist/monetization.cjs.cjs",
      "import": "./dist/monetization.esm.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c rollup.config.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node --import ./test/support/register.mjs --test test/*.test.js",
    "version-patch": "npm version patch",
    "version-deploy": "npm publish"
  },
  "author": "Camilo Alexander Rodriguez Cuaran <camiepisode@outlook.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-loom/link-loom-cloud-sdk.git"
  },
  "homepage": "https://github.com/link-loom/link-loom-cloud-sdk",
  "keywords": [
    "link-loom",
    "cloud",
    "sdk",
    "app-engine",
    "javascript",
    "react"
  ],
  "peerDependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@link-loom/react-sdk": ">=1.1.78",
    "@mui/icons-material": "^6.1.0 || ^7.0.0",
    "@mui/material": "^6.1.0 || ^7.0.0",
    "@veripass/react-sdk": ">=1.1.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-router-dom": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "styled-components": "^6.0.0"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@mui/x-date-pickers": "^8.27.2",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.23",
    "emoji-mart": "^5.6.0",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "^1.0.19",
    "html-to-image": "^1.11.13",
    "ical.js": "^2.2.1",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "marked": "^4.3.0",
    "pptxgenjs": "^4.0.1",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-moveable": "^0.56.0",
    "react-responsive-carousel": "^3.2.23",
    "react-selecto": "^1.26.3",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.76"
  },
